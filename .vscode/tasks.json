{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run FastAPI App",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "sample-app"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Uvicorn running.*",
          "endsPattern": "^.*Shutting down.*"
        }
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "pytest", "tests", "-v"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$pytest"
    },
    {
      "label": "Format Code (Black)",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "black", "."],
      "group": "other"
    },
    {
      "label": "Lint (Pylint)",
      "type": "shell",
      "command": "poetry",
      "args": ["run", "pylint", "src"],
      "group": "other",
      "problemMatcher": "$pylint"
    }
  ]
}
